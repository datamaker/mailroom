{
  "name": "@datasee/mailroom-cli",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "description": "CLI for mailroom, the self-hosted newsletter platform. Manage address books, draft and send newsletters, read delivery stats — or run as an MCP server so Claude can do it for you.",
  "keywords": ["newsletter", "email", "mailroom", "cli", "mcp", "claude", "ses"],
  "license": "MIT",
  "type": "module",
  "bin": { "mailroom": "./dist/index.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "typescript": "^5.5.4"
  }
}
