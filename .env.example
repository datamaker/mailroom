# --- 필수 ---
# 구독자에게 나가는 링크(추적 픽셀, 클릭, 수신거부, 구독폼)에 박히는 주소.
# 반드시 인터넷에서 열리는 주소여야 한다. VPN 전용 주소를 쓰면 링크가 전부 죽는다.
MAILROOM_PUBLIC_URL=https://mail.datasee.co.kr
# 추적/구독 토큰 서명용. 바뀌면 이미 발송된 메일의 링크가 전부 무효가 된다.
MAILROOM_SECRET=

# --- 로그인 (gatehouse SSO) ---
OIDC_ISSUER=https://auth.datasee.co.kr/oidc
OIDC_CLIENT_ID=mailroom
OIDC_CLIENT_SECRET=
MAILROOM_ADMIN_EMAILS=datamaker@datasee.co.kr

# --- 발송 ---
MAILROOM_SEND_PROVIDER=ses
AWS_SES_REGION=us-east-1
# SES 구성 세트 — 바운스/스팸신고 이벤트를 SNS 로 받으려면 필요
AWS_SES_CONFIGURATION_SET=mailroom
# 계정 한도(us-east-1 = 14/s)보다 낮게
MAILROOM_SEND_RATE=12
MAILROOM_SEND_BATCH=200

# --- 기타 ---
POSTGRES_PASSWORD=
PORT=9200
